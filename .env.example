# Aplicação
APP_ENV=development
DEBUG=true
APP_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# APP_SECRET_KEY_FILE=/run/secrets/app_secret_key
APP_BASE_URL=http://localhost:5000
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text

# Segredos criptográficos por finalidade
# Em desenvolvimento, valores vazios mantêm compatibilidade usando APP_SECRET_KEY.
# Em produção, informe valores independentes em base64 URL-safe que codifiquem >= 32 bytes.
# A primeira SESSION_SIGNING_KEYS é ativa; as demais verificam cookies durante a rotação.
SESSION_SIGNING_KEYS=
# SESSION_SIGNING_KEYS_FILE=/run/secrets/session_signing_keys
WTF_CSRF_SECRET_KEY=
# WTF_CSRF_SECRET_KEY_FILE=/run/secrets/csrf_secret_key

# Microsoft Entra ID, single-tenant
MS_ENTRA_CLIENT_ID=substitua-pelo-client-id
MS_ENTRA_CLIENT_SECRET=substitua-por-uma-credencial-com-pelo-menos-24-caracteres
# MS_ENTRA_CLIENT_SECRET_FILE=/run/secrets/ms_entra_client_secret
MS_ENTRA_TENANT_ID=substitua-pelo-tenant-id
MS_ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
MS_ENTRA_SCOPES=User.Read

# Redis, sessão e storage da extensão
# Gere uma senha URL-safe própria para o ambiente local/Compose.
REDIS_PASSWORD=substitua-por-uma-senha-redis-local-forte
REDIS_URL=redis://:substitua-por-uma-senha-redis-local-forte@localhost:6379/0
# REDIS_URL_FILE=/run/secrets/redis_url
REDIS_TLS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_READ_TIMEOUT_SECONDS=3
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
SESSION_LIFETIME_SECONDS=3600
SESSION_REFRESH_EACH_REQUEST=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Microsoft Graph global
# A versão atual aceita somente o endpoint alinhado ao cloud global da extensão 1.0.0.
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_CONNECT_TIMEOUT_SECONDS=3.05
GRAPH_READ_TIMEOUT_SECONDS=10
GRAPH_MAX_RESPONSE_BYTES=65536
GRAPH_MAX_RETRIES=2
GRAPH_MAX_RETRY_AFTER_SECONDS=30

# Proxy: mantenha zero sem proxy confiável conhecido
PROXY_X_FOR=0
PROXY_X_PROTO=0
PROXY_X_HOST=0
PROXY_X_PORT=0
PROXY_X_PREFIX=0

# Aplicação
APP_ENV=development
APP_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
APP_BASE_URL=http://localhost:5000
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_LOG_LEVEL=INFO

# Microsoft Entra ID
MS_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_ENTRA_CLIENT_SECRET=substitua-por-uma-credencial-real
MS_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
MS_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5000/auth/logged-out
MS_ENTRA_SCOPES=User.Read

# Sessão e Redis
REDIS_URL=redis://localhost:6379/0
SESSION_LIFETIME_SECONDS=3600
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Microsoft Graph
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_CONNECT_TIMEOUT_SECONDS=3.05
GRAPH_READ_TIMEOUT_SECONDS=10

# Proxy: mantenha zero sem proxy confiável conhecido
PROXY_X_FOR=0
PROXY_X_PROTO=0
PROXY_X_HOST=0
PROXY_X_PORT=0
PROXY_X_PREFIX=0

# Aplicação
APP_ENV=development
APP_SECRET_KEY=chave-aleatoria-com-pelo-menos-32-caracteres
APP_BASE_URL=http://localhost:5000
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text

# Microsoft Entra ID
MS_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_ENTRA_CLIENT_SECRET=secret-com-pelo-menos-24-caracteres
MS_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
MS_ENTRA_SCOPES=User.Read

# Redis, sessão e storage da extensão
REDIS_URL=redis://localhost:6379/0
REDIS_TLS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_READ_TIMEOUT_SECONDS=3
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
SESSION_LIFETIME_SECONDS=3600
SESSION_REFRESH_EACH_REQUEST=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Microsoft Graph
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_CONNECT_TIMEOUT_SECONDS=3.05
GRAPH_READ_TIMEOUT_SECONDS=10

# Proxy: mantenha zero sem proxy confiável conhecido
PROXY_X_FOR=0
PROXY_X_PROTO=0
PROXY_X_HOST=0
PROXY_X_PORT=0
PROXY_X_PREFIX=0

[build-system]
requires = ["hatchling==1.31.0"]
build-backend = "hatchling.build"

[project]
name = "{{ distribution_name }}"
version = "0.1.0"
description = {{ project_description|tojson }}
readme = "README.md"
requires-python = ">={{ python_version }}"
license = "MIT"
dependencies = [
  "cryptography>=46,<47",
  "Flask>=3.1,<3.2",
  "Flask-WTF>=1.2,<2",
  "flask-ms-entra-auth>=1.0,<2",
  "gunicorn>=23,<27",
  "redis>=6.4,<9",
{% if include_graph_example %}  "requests>=2.32,<3",
{% endif %}]

[project.optional-dependencies]
dev = [
  "bandit>=1.8,<2",
  "build>=1.2,<2",
  "fakeredis>=2.30,<3",
  "mypy>=1.15,<3",
  "pip-audit>=2.8,<3",
  "pytest>=8.3,<10",
  "pytest-cov>=6,<8",
  "python-dotenv>=1.0,<2",
  "ruff>=0.11,<1",
{% if include_graph_example %}  "types-requests>=2.32,<3",
{% endif %}]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
addopts = ["--strict-config", "--strict-markers", "-ra", "--cov={{ package_name }}", "--cov-branch", "--cov-report=term-missing", "--cov-fail-under=80"]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
src = ["src", "tests"]
target-version = "py{{ python_version|replace('.', '') }}"
[tool.ruff.lint]
select = ["B", "E4", "E7", "E9", "F", "I", "RUF", "SIM", "UP"]
[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]
[tool.mypy]
python_version = "{{ python_version }}"
strict = true
mypy_path = "src"
packages = ["{{ package_name }}"]

[tool.coverage.run]
relative_files = true

[tool.coverage.report]
show_missing = true
skip_covered = true

[tool.bandit]
exclude_dirs = ["tests"]

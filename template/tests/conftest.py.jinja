def session_app(redis: RedisDouble, *, clock: Any) -> tuple[Flask, RedisSessionInterface]:
    app = Flask("session-test")
    app.config.from_mapping(
        SECRET_KEY=cryptographic_key(10),
        SESSION_SIGNING_KEYS=(cryptographic_key(11),),
        SESSION_COOKIE_NAME="test_session",
        SESSION_COOKIE_HTTPONLY=True,
        SESSION_COOKIE_SECURE=False,
        SESSION_COOKIE_SAMESITE="Lax",
        SESSION_PERMANENT=True,
        SESSION_REFRESH_EACH_REQUEST=False,
        SESSION_ACTIVITY_UPDATE_SECONDS=60,
    )
    codec = SessionEnvelopeCodec(
        (cryptographic_key(12),),
        namespace="test:session",
        idle_timeout_seconds=120,
        absolute_timeout_seconds=600,
        sid_renewal_seconds=30,
        clock_skew_seconds=5,
        allowed_keys=("value",),
        strict_schema=True,
    )
    interface = RedisSessionInterface(
        redis,
        codec=codec,
        key_prefix="test:session:data:",
        revocation_prefix="test:session:revocation:",
        clock=clock,
    )
    app.session_interface = interface
    return app, interface

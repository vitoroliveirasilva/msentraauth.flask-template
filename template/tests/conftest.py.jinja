def cryptographic_key(seed: int) -> str:
    material = bytes((seed + index) % 256 for index in range(32))
    return base64.urlsafe_b64encode(material).decode("ascii").rstrip("=")


class RedisDouble:
    def __init__(self) -> None:
        self.values: dict[str, bytes] = {}
        self.fail: str | None = None
        self.return_false = False
        self.return_invalid = False
        self.ping_result: object = True
        self._lock = RLock()

    def get(self, name: str) -> bytes | None:
        if self.fail == "get":
            raise RuntimeError("redis-secret")
        if self.return_invalid:
            return "invalid"  # type: ignore[return-value]
        return self.values.get(name)

    def set(
        self,
        name: str,
        value: bytes,
        ex: int | None = None,
        *,
        nx: bool = False,
        xx: bool = False,
    ) -> object:
        del ex
        if self.fail == "set":
            raise RuntimeError("redis-secret")
        if self.return_false:
            return False
        exists = name in self.values
        if (nx and exists) or (xx and not exists):
            return None
        self.values[name] = bytes(value)
        return True

    def delete(self, *names: str) -> int:
        if self.fail == "delete":
            raise RuntimeError("redis-secret")
        removed = 0
        for name in names:
            if name in self.values:
                removed += 1
                del self.values[name]
        return removed

    def eval(self, script: str, numkeys: int, *keys_and_args: object) -> object:
        if self.fail == "eval":
            raise RuntimeError("redis-secret")
        with self._lock:
            keys = tuple(str(value) for value in keys_and_args[:numkeys])
            args = keys_and_args[numkeys:]
            if "9223372036854775806" in script:
                current = self.values.get(keys[0])
                try:
                    revision = 0 if current is None else int(current.decode("ascii"))
                except (UnicodeError, ValueError):
                    return -1
                if revision < 0 or revision >= 2**63 - 2:
                    return -1
                revision += 1
                self.values[keys[0]] = str(revision).encode("ascii")
                return revision
            if numkeys == 2 and "EXISTS" in script:
                old_key, new_key = keys
                stored = self.values.get(old_key)
                expected, new_value, _ttl = args
                if stored is None:
                    return 0
                if stored != expected:
                    return -2
                if new_key in self.values:
                    return -1
                self.values[new_key] = bytes(new_value)  # type: ignore[arg-type]
                del self.values[old_key]
                return 1
            stored = self.values.get(keys[0])
            if "current ~= ARGV[1]" in script:
                if stored is None:
                    return 1
                if not args or stored != args[0]:
                    return 0
                del self.values[keys[0]]
                return 1
            if stored is not None:
                del self.values[keys[0]]
            return stored

    def ping(self) -> object:
        if self.fail == "ping":
            raise RuntimeError("redis-secret")
        return self.ping_result


class FakeMsalClient:
    def __init__(self) -> None:
        self.cache: SerializableTokenCache | None = None
        self.accounts: Sequence[MsalAccount] = [
            {
                "home_account_id": "home-id",
                "local_account_id": "object-id",
                "realm": "tenant-id",
            }
        ]

    def initiate_auth_code_flow(
        self,
        scopes: list[str],
        *,
        redirect_uri: str,
        state: str,
    ) -> MsalResult:
        del scopes
        return {
            "auth_uri": f"https://login.microsoftonline.com/tenant/oauth2/v2.0/authorize?state={state}",
            "state": state,
            "nonce": "nonce",
            "redirect_uri": redirect_uri,
        }

    def acquire_token_by_auth_code_flow(
        self,
        auth_code_flow: Mapping[str, object],
        auth_response: Mapping[str, str],
    ) -> MsalResult:
        assert auth_code_flow["state"] == auth_response["state"]
        return {
            "id_token_claims": {
                "oid": "object-id",
                "tid": "tenant-id",
                "name": "Test User",
                "preferred_username": "user@example.test",
            }
        }

    def get_accounts(self, username: str | None = None) -> Sequence[MsalAccount]:
        del username
        return self.accounts

    def acquire_token_silent_with_error(
        self,
        scopes: list[str],
        account: MsalAccount,
        *,
        force_refresh: bool = False,
    ) -> MsalResult | None:
        del scopes, account, force_refresh
        return {"access_token": "server-only-token"}



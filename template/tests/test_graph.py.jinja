from __future__ import annotations

import json
from collections.abc import Mapping

import pytest
import requests

from {{ package_name }}.features.graph.client import (
    GraphClaimsChallenge,
    GraphClient,
    GraphError,
    GraphForbidden,
    GraphRateLimited,
    GraphRedirectRejected,
    GraphResponseTooLarge,
    GraphUnauthorized,
    GraphUnavailable,
    HttpResponse,
)


class Transport:
    def __init__(self) -> None:
        self.response = HttpResponse(
            200,
            {"Content-Type": "application/json"},
            json.dumps(
                {
                    "id": "user-id",
                    "displayName": "Test User",
                    "userPrincipalName": "user@example.test",
                    "mail": None,
                }
            ).encode(),
        )
        self.error: Exception | None = None
        self.calls: list[tuple[str, Mapping[str, str]]] = []

    def get(
        self,
        url: str,
        *,
        headers: Mapping[str, str],
        params: Mapping[str, str],
        timeout: tuple[float, float],
    ) -> HttpResponse:
        del params, timeout
        self.calls.append((url, headers))
        if self.error is not None:
            raise self.error
        return self.response


def client(transport: Transport) -> GraphClient:
    return GraphClient(
        base_url="https://graph.microsoft.com/v1.0",
        connect_timeout=1.0,
        read_timeout=2.0,
        transport=transport,
    )


def test_profile_is_bounded_and_token_stays_in_authorization_header() -> None:
    transport = Transport()
    profile = client(transport).get_profile(" secret-token ")
    assert profile.id == "user-id"
    assert profile.display_name == "Test User"
    assert transport.calls == [
        (
            "https://graph.microsoft.com/v1.0/me",
            {"Accept": "application/json", "Authorization": "Bearer secret-token"},
        )
    ]


@pytest.mark.parametrize(
    ("response", "error"),
    [
        (HttpResponse(302, {}, None), GraphRedirectRejected),
        (HttpResponse(401, {}, None), GraphUnauthorized),
        (HttpResponse(403, {}, None), GraphForbidden),
        (HttpResponse(429, {"Retry-After": "5"}, None), GraphRateLimited),
        (HttpResponse(503, {"Retry-After": "999"}, None), GraphUnavailable),
        (HttpResponse(418, {}, None), GraphError),
        (HttpResponse(200, {}, b"not-json"), GraphError),
        (HttpResponse(200, {}, b"[]"), GraphError),
        (HttpResponse(200, {}, b'{"id":"x"}'), GraphError),
    ],
)
def test_graph_status_and_payload_errors_are_mapped(
    response: HttpResponse,
    error: type[GraphError],
) -> None:
    transport = Transport()
    transport.response = response
    with pytest.raises(error):
        client(transport).get_profile("token")


def test_claims_challenge_is_parsed_but_not_exposed_in_message() -> None:
    transport = Transport()
    transport.response = HttpResponse(
        401,
        {"WWW-Authenticate": 'Bearer claims="{\\"access_token\\":{\\"xms_cc\\":{\\"values\\":[\\"cp1\\"]}}}"'},
        None,
    )
    with pytest.raises(GraphClaimsChallenge) as raised:
        client(transport).get_profile("token")
    assert json.loads(raised.value.claims)["access_token"]
    assert "cp1" not in str(raised.value)


def test_network_errors_and_invalid_constructor_values() -> None:
    transport = Transport()
    transport.error = requests.Timeout("secret")
    with pytest.raises(GraphUnavailable, match="unavailable"):
        client(transport).get_profile("token")
    with pytest.raises(ValueError, match="access_token"):
        client(transport).get_profile("")
    with pytest.raises(ValueError, match="approved"):
        GraphClient(
            base_url="https://evil.example.test",
            connect_timeout=1,
            read_timeout=1,
            transport=transport,
        )
    with pytest.raises(ValueError, match="timeouts"):
        GraphClient(
            base_url="https://graph.microsoft.com/v1.0",
            connect_timeout=0,
            read_timeout=1,
            transport=transport,
        )
    with pytest.raises(TypeError, match="transport"):
        GraphClient(
            base_url="https://graph.microsoft.com/v1.0",
            connect_timeout=1,
            read_timeout=1,
            transport=object(),  # type: ignore[arg-type]
        )


def test_http_response_json_and_size_error_types() -> None:
    assert HttpResponse(204, {}, None).json() is None
    with pytest.raises(GraphResponseTooLarge):
        raise GraphResponseTooLarge("too large")

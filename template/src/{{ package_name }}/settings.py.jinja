    def validate(self) -> None:
        if not isinstance(self.proxy_hops, ProxyHops) or any(
            isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 5
            for value in (
                self.proxy_hops.x_for,
                self.proxy_hops.x_proto,
                self.proxy_hops.x_host,
                self.proxy_hops.x_port,
                self.proxy_hops.x_prefix,
            )
        ):
            raise SettingsError("proxy hop counts must be integers between 0 and 5")
        if self.session_absolute_timeout_seconds < self.session_lifetime_seconds:
            raise SettingsError("SESSION_ABSOLUTE_TIMEOUT_SECONDS cannot be shorter than SESSION_LIFETIME_SECONDS")
        if self.session_sid_renewal_seconds >= self.session_absolute_timeout_seconds:
            raise SettingsError("SESSION_SID_RENEWAL_SECONDS must be shorter than the absolute timeout")
        if self.session_activity_update_seconds > self.session_lifetime_seconds:
            raise SettingsError("SESSION_ACTIVITY_UPDATE_SECONDS cannot exceed the idle timeout")
        base = urlsplit(self.base_url)
        redirect = urlsplit(self.redirect_uri)
        if _origin(base) != _origin(redirect):
            raise SettingsError("MS_ENTRA_REDIRECT_URI must use the same origin as APP_BASE_URL")
        if self.cookie_samesite == "None" and not self.cookie_secure:
            raise SettingsError("SESSION_COOKIE_SECURE must be true when SameSite=None")
        try:
            self.create_session_codec()
        except (TypeError, ValueError) as exc:
            raise SettingsError("session codec configuration is invalid") from exc
{% if include_graph_example %}        if self.graph_enabled and "User.Read" not in self.scopes:
            raise SettingsError(
                "MS_ENTRA_SCOPES must include User.Read when the Graph example is enabled"
            )
{% endif %}
        if self.environment == "production":
            if base.scheme != "https" or not self.cookie_secure or not self.redis_tls_required:
                raise SettingsError("production requires HTTPS, Secure cookies and Redis TLS")
            if self.testing or self.debug or not self.csrf_enabled or not self.session_schema_strict:
                raise SettingsError("production forbids testing/debug and requires CSRF + strict session schema")
            secrets = (
                self.secret_key,
                self.csrf_secret_key,
                self.client_secret,
                *self.session_signing_keys,
                *self.session_payload_keys,
            )
            if len(set(secrets)) != len(secrets):
                raise SettingsError("production secrets must use independent values")


def _text(
    values: Mapping[str, str],
    name: str,
    default: str | None = None,
    *,
    maximum: int = _MAX_SECRET_CHARACTERS,
) -> str:
    raw = values.get(name, default)
    if raw is None or not raw.strip():
        raise SettingsError(f"{name} is required")
    value = raw.strip()
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        raise SettingsError(f"{name} contains control characters")
    if len(value) > maximum:
        raise SettingsError(f"{name} exceeds the maximum length")
    return value


def _optional_text(values: Mapping[str, str], name: str) -> str:
    raw = values.get(name, "").strip()
    if len(raw) > _MAX_SECRET_CHARACTERS or any(
        ord(character) < 32 or ord(character) == 127 for character in raw
    ):
        raise SettingsError(f"{name} is invalid")
    return raw


def _secret_raw(values: Mapping[str, str], name: str, *, required: bool) -> str:
    direct = values.get(name, "").strip()
    file_value = values.get(f"{name}_FILE", "").strip()
    if direct and file_value:
        raise SettingsError(f"{name} and {name}_FILE cannot be configured together")
    if file_value:
        path = Path(file_value)
        if not path.is_absolute():
            raise SettingsError(f"{name}_FILE must be an absolute path")
        try:
            meta = path.stat()
            if not stat.S_ISREG(meta.st_mode) or meta.st_size > _MAX_SECRET_FILE_BYTES:
                raise SettingsError(f"{name}_FILE must reference a small regular file")
            value = path.read_text(encoding="utf-8").rstrip("\r\n")
        except OSError as exc:
            raise SettingsError(f"{name}_FILE could not be read") from exc
        if not value:
            raise SettingsError(f"{name}_FILE is empty")
        if len(value) > _MAX_SECRET_CHARACTERS or any(
            ord(character) < 32 or ord(character) == 127 for character in value
        ):
            raise SettingsError(f"{name}_FILE contains an invalid value")
        return value
    if direct:
        if len(direct) > _MAX_SECRET_CHARACTERS or any(
            ord(character) < 32 or ord(character) == 127 for character in direct
        ):
            raise SettingsError(f"{name} contains an invalid value")
        return direct
    if required:
        raise SettingsError(f"{name} is required")
    return ""


def _secret(values: Mapping[str, str], name: str, *, environment: str, cryptographic: bool, minimum: int = 32) -> str:
    value = _secret_raw(values, name, required=True)
    if len(value) < minimum or len(value) > _MAX_SECRET_CHARACTERS:
        raise SettingsError(f"{name} has an invalid length")
    if environment == "production" and cryptographic:
        _base64_secret(value, name)
    if environment == "production" and not cryptographic and len(set(value)) < 8:
        raise SettingsError(f"{name} does not have enough character diversity")
    return value


def _secret_ring(values: Mapping[str, str], name: str, *, environment: str) -> tuple[str, ...]:
    raw = _secret_raw(values, name, required=environment == "production")
    if not raw:
        return ()
    items = tuple(part.strip() for part in re.split(r"[,\r\n]+", raw) if part.strip())
    if len(items) > _MAX_SESSION_KEYS or len(set(items)) != len(items):
        raise SettingsError(f"{name} must contain one to five unique keys")
    for item in items:
        if len(item) < 32:
            raise SettingsError(f"{name} keys must contain at least 32 characters")
        if environment == "production":
            _base64_secret(item, name)
    return items


def _base64_secret(value: str, name: str) -> None:
    if not _BASE64URL_RE.fullmatch(value):
        raise SettingsError(f"{name} must be URL-safe base64 in production")
    try:
        decoded = base64.urlsafe_b64decode((value + "=" * (-len(value) % 4)).encode("ascii"))
    except (UnicodeError, binascii.Error, ValueError) as exc:
        raise SettingsError(f"{name} must be URL-safe base64 in production") from exc
    if len(decoded) < 32:
        raise SettingsError(f"{name} must encode at least 32 random bytes in production")


def _boolean(values: Mapping[str, str], name: str, default: bool) -> bool:
    raw = values.get(name)
    if raw is None:
        return default
    normalized = raw.strip().lower()
    if normalized in {"1", "true", "yes", "on"}:
        return True
    if normalized in {"0", "false", "no", "off"}:
        return False
    raise SettingsError(f"{name} must be boolean")


def _csv(values: Mapping[str, str], name: str, default: str) -> tuple[str, ...]:
    raw = values.get(name, default)
    return tuple(dict.fromkeys(part.strip() for part in raw.split(",") if part.strip()))


def _choice(value: str, name: str, allowed: frozenset[str]) -> str:
    if value not in allowed:
        raise SettingsError(f"{name} must be one of: {', '.join(sorted(allowed))}")
    return value


def _positive_int(values: Mapping[str, str], name: str, default: int, maximum: int) -> int:
    value = _non_negative_int(values, name, default, maximum)
    if value == 0:
        raise SettingsError(f"{name} must be positive")
    return value


def _non_negative_int(values: Mapping[str, str], name: str, default: int, maximum: int) -> int:
    try:
        value = int(values.get(name, str(default)))
    except ValueError as exc:
        raise SettingsError(f"{name} must be an integer") from exc
    if value < 0 or value > maximum:
        raise SettingsError(f"{name} must be between 0 and {maximum}")
    return value


def _positive_float(values: Mapping[str, str], name: str, default: float) -> float:
    try:
        value = float(values.get(name, str(default)))
    except ValueError as exc:
        raise SettingsError(f"{name} must be numeric") from exc
    if not isfinite(value) or value <= 0 or value > _MAX_TIMEOUT_SECONDS:
        raise SettingsError(f"{name} must be a finite positive value <= {_MAX_TIMEOUT_SECONDS:g}")
    return value


def _slug(value: str) -> str:
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", value):
        raise SettingsError("APP_SLUG must use lowercase kebab-case")
    return value


def _namespace(value: str) -> str:
    if len(value) > _MAX_NAMESPACE_CHARACTERS or not _NAMESPACE_RE.fullmatch(value):
        raise SettingsError("SESSION_NAMESPACE contains unsupported characters")
    return value


def _base_url(value: str) -> str:
    parsed = _web_url(value, "APP_BASE_URL")
    if parsed.query or parsed.path not in {"", "/"}:
        raise SettingsError("APP_BASE_URL must contain only the origin")
    return _canonical_origin(parsed)


def _redirect_uri(value: str) -> str:
    parsed = _web_url(value, "MS_ENTRA_REDIRECT_URI")
    if (
        parsed.query
        or "%" in parsed.path
        or not _CALLBACK_PATH_RE.fullmatch(parsed.path)
        or parsed.path in {"", "/"}
        or parsed.path.endswith("/")
    ):
        raise SettingsError("MS_ENTRA_REDIRECT_URI must use a static non-root callback path")
    if "//" in parsed.path or any(part in {".", ".."} for part in parsed.path.split("/")):
        raise SettingsError("MS_ENTRA_REDIRECT_URI contains an ambiguous path")
    return value


def _web_url(value: str, name: str) -> SplitResult:
    parsed = urlsplit(value)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password or parsed.fragment:
        raise SettingsError(f"{name} must be an absolute safe URL")
    if parsed.scheme == "http" and not _is_loopback(parsed.hostname):
        raise SettingsError(f"{name} must use HTTPS outside loopback")
    _canonical_hostname(parsed.hostname, name)
    try:
        if parsed.port == 0:
            raise SettingsError(f"{name} contains an invalid port")
    except ValueError as exc:
        raise SettingsError(f"{name} contains an invalid port") from exc
    return parsed


def _canonical_origin(parsed: SplitResult) -> str:
    host = _canonical_hostname(parsed.hostname or "", "APP_BASE_URL")
    rendered = f"[{host}]" if ":" in host else host
    default_port = 443 if parsed.scheme == "https" else 80
    authority = rendered if parsed.port in {None, default_port} else f"{rendered}:{parsed.port}"
    return f"{parsed.scheme}://{authority}"


def _trusted_hosts(values: Sequence[str]) -> tuple[str, ...]:
    result: list[str] = []
    for value in values:
        if "*" in value or value.startswith(".") or any(token in value for token in ("://", "/", "@", "?", "#")):
            raise SettingsError("APP_TRUSTED_HOSTS must contain exact hosts only")
        host = value
        port: int | None = None
        if value.startswith("["):
            closing = value.find("]")
            if closing < 0:
                raise SettingsError("APP_TRUSTED_HOSTS contains an invalid IPv6 host")
            host = value[1:closing]
            suffix = value[closing + 1 :]
            if suffix:
                if not suffix.startswith(":") or not suffix[1:].isdigit():
                    raise SettingsError("APP_TRUSTED_HOSTS contains an invalid port")
                port = int(suffix[1:])
        elif value.count(":") == 1:
            candidate, raw_port = value.rsplit(":", 1)
            if raw_port.isdigit():
                host, port = candidate, int(raw_port)
        canonical = _canonical_hostname(host, "APP_TRUSTED_HOSTS")
        rendered = f"[{canonical}]" if ":" in canonical else canonical
        if port is not None:
            if not 1 <= port <= 65535:
                raise SettingsError("APP_TRUSTED_HOSTS contains an invalid port")
            rendered = f"{rendered}:{port}"
        if rendered not in result:
            result.append(rendered)
    if not result:
        raise SettingsError("APP_TRUSTED_HOSTS must not be empty")
    return tuple(result)


def _canonical_hostname(hostname: str, name: str) -> str:
    normalized = hostname.lower().rstrip(".")
    try:
        return ip_address(normalized).compressed
    except ValueError:
        pass
    try:
        ascii_host = normalized.encode("idna").decode("ascii")
    except UnicodeError as exc:
        raise SettingsError(f"{name} contains an invalid host") from exc
    if not ascii_host or len(ascii_host) > 253 or any(not _HOST_LABEL_RE.fullmatch(label) for label in ascii_host.split(".")):
        raise SettingsError(f"{name} contains an invalid host")
    return ascii_host


def _client_id(value: str, environment: str) -> str:
    try:
        return str(UUID(value))
    except ValueError as exc:
        if environment == "production":
            raise SettingsError("MS_ENTRA_CLIENT_ID must be a UUID in production") from exc
        return value


def _tenant_id(value: str) -> str:
    normalized = value.lower()
    if normalized in {"common", "consumers", "organizations"}:
        raise SettingsError("MS_ENTRA_TENANT_ID must identify one tenant")
    try:
        return str(UUID(normalized))
    except ValueError:
        return _canonical_hostname(normalized, "MS_ENTRA_TENANT_ID")


def _local_path(value: str, name: str) -> str:
    parsed = urlsplit(value)
    if (
        not value.startswith("/")
        or value.startswith("//")
        or "\\" in value
        or "%" in value
        or parsed.netloc
        or parsed.query
        or parsed.fragment
        or "//" in parsed.path
        or any(part in {".", ".."} for part in parsed.path.split("/"))
    ):
        raise SettingsError(f"{name} must be an application-local path")
    return value


def _redis_url(value: str, tls_required: bool) -> str:
    if len(value) > _MAX_SECRET_CHARACTERS or any(
        ord(character) < 32 or ord(character) == 127 for character in value
    ):
        raise SettingsError("REDIS_URL contains an invalid value")
    parsed = urlsplit(value)
    if parsed.scheme not in {"redis", "rediss"} or not parsed.hostname or parsed.fragment:
        raise SettingsError("REDIS_URL must be an absolute redis/rediss URL")
    controlled = {key.casefold() for key, _ in parse_qsl(parsed.query, keep_blank_values=True)} & _REDIS_CONTROLLED_QUERY_OPTIONS
    if controlled:
        raise SettingsError(f"REDIS_URL cannot override application-controlled options: {', '.join(sorted(controlled))}")
    if tls_required and parsed.scheme != "rediss":
        raise SettingsError("REDIS_URL must use rediss when REDIS_TLS_REQUIRED=true")
    return value


def _regular_file(value: object, name: str) -> str:
    if value == "":
        return ""
    if not isinstance(value, str) or not Path(value).is_absolute():
        raise SettingsError(f"{name} must reference an absolute regular file")
    try:
        metadata = Path(value).stat()
    except OSError as exc:
        raise SettingsError(f"{name} could not be inspected") from exc
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > _MAX_CA_FILE_BYTES:
        raise SettingsError(f"{name} must reference a small regular file")
    return value


def _samesite(value: str) -> str:
    normalized = value.capitalize()
    if normalized not in {"Lax", "Strict", "None"}:
        raise SettingsError("SESSION_COOKIE_SAMESITE must be Lax, Strict, or None")
    return normalized


def _csp_origins(values: Sequence[str], name: str) -> tuple[str, ...]:
    safe: list[str] = []
    for value in values:
        if value in {"'unsafe-inline'", "'unsafe-eval'", "*"}:
            raise SettingsError(f"{name} cannot weaken CSP with {value}")
        parsed = urlsplit(value)
        if (
            parsed.scheme != "https"
            or not parsed.hostname
            or parsed.username
            or parsed.password
            or parsed.path not in {"", "/"}
            or parsed.query
            or parsed.fragment
        ):
            raise SettingsError(f"{name} accepts explicit HTTPS origins only")
        safe.append(_canonical_origin(parsed))
    return tuple(dict.fromkeys(safe))


def _scopes(values: Sequence[str]) -> tuple[str, ...]:
    if len(values) > 32 or any(not _SCOPE_RE.fullmatch(value) for value in values):
        raise SettingsError("MS_ENTRA_SCOPES contains an invalid scope")
    return tuple(values)


def _policy_features(values: Sequence[str]) -> tuple[str, ...]:
    if len(values) > 32 or any(
        not _POLICY_FEATURE_RE.fullmatch(value) for value in values
    ):
        raise SettingsError("PERMISSIONS_POLICY_FEATURES contains an invalid feature")
    return tuple(values)


def _origin(parsed: SplitResult) -> tuple[str, str, int]:
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    return parsed.scheme.lower(), _canonical_hostname(parsed.hostname or "", "URL"), port


def _is_loopback(hostname: str | None) -> bool:
    normalized = (hostname or "").lower().rstrip(".")
    if normalized == "localhost":
        return True
    try:
        return ip_address(normalized).is_loopback
    except ValueError:
        return False


def _graph_base_url(value: str) -> str:
    canonical = value.rstrip("/")
    if canonical not in _GRAPH_BASE_URLS:
        raise SettingsError("GRAPH_BASE_URL must use an approved Microsoft Graph endpoint")
    return canonical
